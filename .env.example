# .env.example - Copiar a .env y configurar

# ===========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===========================================
APP_NAME=Organizador de Gastos Inteligente
APP_VERSION=3.0.0-mobile
DEBUG=False

# ===========================================
# BASE DE DATOS LOCAL
# ===========================================
DB_PATH=data/finanzas.db
BACKUP_ENABLED=True
AUTO_BACKUP_INTERVAL=3600

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ===========================================
# UI (Desktop)
# ===========================================
DEFAULT_THEME=light
WINDOW_WIDTH=1000
WINDOW_HEIGHT=700

# ===========================================
# FEATURES
# ===========================================
ENABLE_AI=True
ENABLE_DARK_MODE=True
ENABLE_EXPORT=True
ENABLE_IMPORT=True

# ===========================================
# PERFORMANCE
# ===========================================
CACHE_TTL=3600
MAX_CACHE_SIZE=100
REFRESH_RATE=1000

# ===========================================
# AI (OpenAI)
# ===========================================
OPENAI_ENABLED=False
AI_MODEL=gpt-3.5-turbo

# ===========================================
# CLOUD SYNC (Firebase) - OPCIONAL
# ===========================================
# Para habilitar sync, necesitas:
# 1. Crear proyecto en Firebase Console
# 2. Descargar firebase_credentials.json
# 3. Configurar estas variables

FIREBASE_ENABLED=False
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_PROJECT_ID=tu-proyecto-firebase
SYNC_ENABLED=False
AUTO_SYNC_INTERVAL=300

# ===========================================
# MOBILE
# ===========================================
MOBILE_APP_ID=org.alandin123.organizador
MOBILE_APP_VERSION=1.0.0
