# .env
# Configuración de la aplicación

# Aplicación
APP_NAME=Organizador de Gastos Inteligente
APP_VERSION=2.0.0
DEBUG=False

# Base de datos
DB_PATH=data/finanzas.db
BACKUP_ENABLED=True
AUTO_BACKUP_INTERVAL=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# UI
DEFAULT_THEME=light
WINDOW_WIDTH=1000
WINDOW_HEIGHT=700

# Features
ENABLE_AI=True
ENABLE_DARK_MODE=True
ENABLE_EXPORT=True
ENABLE_IMPORT=True

# Performance
CACHE_TTL=3600
MAX_CACHE_SIZE=100
REFRESH_RATE=1000

# AI
OPENAI_ENABLED=False
AI_MODEL=gpt-3.5-turbo
